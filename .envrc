use flake

watch_file pyproject.toml
watch_file uv.lock
watch_file .python-version

if command -v nvidia-smi >/dev/null 2>&1 && nvidia-smi >/dev/null 2>&1; then
  ACCELERATOR=cuda
elif [[ "$(uname -s)" == Darwin && "$(uname -m)" == arm64 ]]; then
  ACCELERATOR=mlx
elif [[ -n "${ROCM_PATH:-}" || -n "${ROCM_HOME:-}" || -x /opt/rocm/bin/rocminfo ]]; then
  ACCELERATOR=rocm
else
  ACCELERATOR=cpu
fi
export ACCELERATOR

if [[ -z "${AGENTS_CTL_QUIET_DEVENV:-}" ]]; then
  echo "Using accelerator: $ACCELERATOR"
fi

if [[ "$ACCELERATOR" == cpu && "$(uname -s)" != Linux ]]; then
  uv sync --locked
elif [[ "$ACCELERATOR" == cpu ]]; then
  uv sync --locked --extra cpu
else
  uv sync --locked --extra "$ACCELERATOR"
fi

# Keep uv run from dropping the selected accelerator extra on each invocation.
export UV_NO_SYNC=1
source .venv/bin/activate
